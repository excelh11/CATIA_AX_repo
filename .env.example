# C:\CATIA_AX\.env 양식 — 이 파일을 복사해 이름을 .env 로 바꾼 뒤, 본인 값으로 채우세요.
#   copy .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다. (이 .env.example 에는 진짜 값을 넣지 마세요)

# 엘리스 [연결] → [빠른 연결] 의 SSH 명령  ssh -i <키> <ELICE_USER>@<ELICE_HOST> -p <ELICE_PORT>
ELICE_HOST=
ELICE_PORT=
ELICE_USER=elicer

# Step 23 에서 받은 비밀키 (Windows 환경 변수 %USERPROFILE% 사용 가능)
ELICE_PEM=%USERPROFILE%\Downloads\my-elice.pem

# Step 24 에서 클라우드로 올려 보낼 비식별 STEP (C:\CATIA_AX 기준 경로)
STEP_FILE=code/data/deid/LPM_OPENER_deid.stp
